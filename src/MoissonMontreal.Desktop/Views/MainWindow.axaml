<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MoissonMontreal.Desktop.ViewModels"
        xmlns:design="using:MoissonMontreal.Desktop.Design"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="MoissonMontreal.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Design.DataContext="{x:Static design:DesignData.Main}"
        Icon="/Assets/avalonia-logo.ico"
        Title="Moisson Montréal">

    <DockPanel>
        <StackPanel DockPanel.Dock="Top"
                              Orientation="Horizontal"
                              Spacing="8"
                              Margin="8"
                              IsVisible="{Binding IsSignedIn}">
            <Button Content="Home"      Command="{Binding ShowHomeCommand}" />
            <Button Content="Donations" Command="{Binding ShowDonationsCommand}" />
            <Button Content="Donors"    Command="{Binding ShowDonorsCommand}" />
            <Button Content="Sign out"  Command="{Binding SignOutCommand}" />
        </StackPanel>

        <ContentControl Content="{Binding CurrentPage}"/>
    </DockPanel>
    

</Window>
