// Full database schema of the Moisson Montreal receipt app
// Paste this file into https://dbdiagram.io to render the diagram.
// Matches the migrations 20261103000127_CreateUsersAndRoles, 20261105163138_CreateDonorsAndFoodItems,
// 20261107041912_CreateReceipts, 20261110175320_CreateCatalogItemsAndPrices,
// 20261112060008_CreateQualityClasses, 20261117040905_AddCatalogItemDetails,
// 20261120031640_MakeCatalogItemQualityClassOptional, 20261124214039_AddBcItemMappings and 20261127052039_AddReceiptStatus.

Project moisson_montreal {
  database_type: 'PostgreSQL'
  Note: 'Accounts of the employees, donors and their donated food with its quality class, the tax receipts with the prices used to value them, and the price grid'
}

Table roles {
  id integer [not null, note: 'Fixed values, inserted by the migration']
  code varchar(50) [not null, note: 'Stable identifier used by the permission checks']
  name varchar(100) [not null, note: 'Label shown in the app']

  indexes {
    id [pk, name: 'pk_roles']
    code [unique, name: 'ix_roles_code']
    name [unique, name: 'ix_roles_name']
  }

  Note: 'Department-based roles that determine what a user can see and do'
}

Table users {
  id integer [not null, increment]
  email varchar(256) [not null, note: 'Work email, always lowercase']
  entra_object_id uuid [null, note: 'Microsoft Entra id, filled on the first permission check']
  display_name varchar(200) [not null]
  role_id integer [not null]
  is_active boolean [not null, default: true, note: 'False once the admin removes access']
  created_at timestamptz [not null, default: `now()`, note: 'Stored in UTC']
  updated_at timestamptz [null, note: 'Stored in UTC, empty if never changed']

  indexes {
    id [pk, name: 'pk_users']
    email [unique, name: 'ix_users_email']
    entra_object_id [unique, name: 'ix_users_entra_object_id']
    role_id [name: 'ix_users_role_id']
  }

  checks {
    `email = lower(email)` [name: 'ck_users_email_lowercase']
  }

  Note: 'Employees allowed to use the app'
}

Table donors {
  id uuid [not null, default: `gen_random_uuid()`]
  name varchar(255) [not null]
  address text [null]
  postal_code varchar(20) [null]
  contact_person varchar(255) [null]
  created_at timestamptz [not null, default: `now()`, note: 'Stored in UTC']

  indexes {
    id [pk, name: 'pk_donors']
  }

  checks {
    `length(name) > 0` [name: 'ck_donors_name_not_empty']
  }

  Note: 'Organizations or people who give food'
}

Table food_items {
  id uuid [not null, default: `gen_random_uuid()`]
  donor_id uuid [not null]
  name varchar(255) [not null]
  quantity numeric(12,2) [not null]
  unit varchar(20) [not null]
  donation_date date [not null, note: 'Date the food was received']
  quality varchar(1) [not null, note: 'Code of the quality class']
  catalog_item_id uuid [null, note: 'Catalog item of the donation, which gives its price. Empty until it is matched to the catalog']
  created_at timestamptz [not null, default: `now()`, note: 'Stored in UTC']

  indexes {
    id [pk, name: 'pk_food_items']
    (id, donor_id) [unique, name: 'ak_food_items_id_donor_id', note: 'Lets receipt_items check the donor']
    donor_id [name: 'ix_food_items_donor_id']
    catalog_item_id [name: 'ix_food_items_catalog_item_id']
    quality [name: 'ix_food_items_quality']
  }

  checks {
    `length(name) > 0` [name: 'ck_food_items_name_not_empty']
    `quantity > 0` [name: 'ck_food_items_quantity_positive']
    `length(unit) > 0` [name: 'ck_food_items_unit_not_empty']
  }

  Note: 'Food donated by a donor, with its date and quality'
}

Table quality_classes {
  code varchar(1) [not null, note: 'One capital letter from A to Z, such as A, B or C']
  name varchar(100) [not null]
  percentage numeric(5,2) [not null, note: 'Percentage of the price applied by default']
  min_percentage numeric(5,2) [not null, note: 'Lowest percentage allowed']
  max_percentage numeric(5,2) [not null, note: 'Highest percentage allowed']

  indexes {
    code [pk, name: 'pk_quality_classes']
    name [unique, name: 'ix_quality_classes_name']
  }

  checks {
    `code ~ '^[A-Z]$'` [name: 'ck_quality_classes_code_format']
    `length(name) > 0` [name: 'ck_quality_classes_name_not_empty']
    `min_percentage >= 0 AND min_percentage <= max_percentage AND max_percentage <= 100` [name: 'ck_quality_classes_range_valid']
    `percentage BETWEEN min_percentage AND max_percentage` [name: 'ck_quality_classes_percentage_in_range']
  }

  Note: 'Quality classes of donated food. Initial values follow the PRD and are to be confirmed with Nafissa'
}

Table receipts {
  id uuid [not null, default: `gen_random_uuid()`]
  donor_id uuid [not null]
  total_amount numeric(12,2) [not null, note: 'Sum of the rounded line values, in dollars']
  receipt_date date [not null, default: `(now() AT TIME ZONE 'America/Montreal')::date`, note: 'Date in Montreal time, used for the tax year']
  created_at timestamptz [not null, default: `now()`, note: 'Stored in UTC']
  status varchar(30) [not null, default: 'Draft', note: 'Where the receipt is in the approval process. See receipt-statuses.md']

  indexes {
    id [pk, name: 'pk_receipts']
    (id, donor_id) [unique, name: 'ak_receipts_id_donor_id', note: 'Lets receipt_items check the donor']
    donor_id [name: 'ix_receipts_donor_id']
  }

  checks {
    `total_amount >= 0` [name: 'ck_receipts_total_amount_not_negative']
    `status IN ('Draft', 'PendingSupplyApproval', 'PendingFinanceApproval', 'Approved', 'Issued', 'Cancelled')` [name: 'ck_receipts_status_valid']
  }

  Note: 'Tax receipts given to donors'
}

Table receipt_status_changes {
  id uuid [not null, default: `gen_random_uuid()`]
  receipt_id uuid [not null]
  from_status varchar(30) [not null, note: 'Status before the change']
  to_status varchar(30) [not null, note: 'Status after the change']
  changed_by_user_id integer [not null, note: 'Employee who made the change']
  changed_at timestamptz [not null, default: `now()`, note: 'Stored in UTC']
  reason varchar(1000) [null, note: 'Required when a receipt is refused or cancelled']

  indexes {
    id [pk, name: 'pk_receipt_status_changes']
    (receipt_id, changed_at) [name: 'ix_receipt_status_changes_receipt_id_changed_at']
    changed_by_user_id [name: 'ix_receipt_status_changes_changed_by_user_id']
  }

  checks {
    `from_status IN ('Draft', 'PendingSupplyApproval', 'PendingFinanceApproval', 'Approved', 'Issued', 'Cancelled')` [name: 'ck_receipt_status_changes_from_status_valid']
    `to_status IN ('Draft', 'PendingSupplyApproval', 'PendingFinanceApproval', 'Approved', 'Issued', 'Cancelled')` [name: 'ck_receipt_status_changes_to_status_valid']
    `from_status <> to_status` [name: 'ck_receipt_status_changes_status_differs']
    `length(reason) > 0` [name: 'ck_receipt_status_changes_reason_not_empty']
    `to_status NOT IN ('Draft', 'Cancelled') OR reason IS NOT NULL` [name: 'ck_receipt_status_changes_reason_required']
  }

  Note: 'One row per status change of a receipt: who made it, when, and why'
}

Table receipt_items {
  receipt_id uuid [not null]
  food_item_id uuid [not null]
  donor_id uuid [not null, note: 'Donor of both the receipt and the food item']
  quantity numeric(12,2) [not null, note: 'Copied from the food item when the receipt was made']
  unit varchar(20) [not null, note: 'Copied from the food item when the receipt was made']
  unit_price numeric(12,4) [not null, note: 'Price of one unit when the receipt was made']
  quality_percent numeric(5,2) [not null, note: 'A = 100, B = 50 to 75, C = 0']
  receipt_cancelled boolean [not null, default: false, note: 'True once the receipt is cancelled. The line is kept, but the food item is free again']

  indexes {
    (receipt_id, food_item_id) [pk, name: 'pk_receipt_items']
    food_item_id [unique, name: 'ix_receipt_items_food_item_id', note: 'Partial index where `NOT receipt_cancelled`: a food item can be on only one receipt that is not cancelled']
    (food_item_id, donor_id) [name: 'ix_receipt_items_food_item_id_donor_id']
    (receipt_id, donor_id) [name: 'ix_receipt_items_receipt_id_donor_id']
  }

  checks {
    `quantity > 0` [name: 'ck_receipt_items_quantity_positive']
    `length(unit) > 0` [name: 'ck_receipt_items_unit_not_empty']
    `unit_price > 0` [name: 'ck_receipt_items_unit_price_positive']
    `quality_percent BETWEEN 0 AND 100` [name: 'ck_receipt_items_quality_percent_range']
  }

  Note: 'Food items on a receipt. Line value = round(quantity x unit_price x quality_percent / 100, 2), half away from zero'
}

Table catalog_items {
  id uuid [not null, default: `gen_random_uuid()`]
  name varchar(255) [not null]
  category varchar(100) [not null]
  business_central_code varchar(50) [not null, note: 'Unique code used to match the item in Business Central']
  unit varchar(20) [not null, note: 'Free text until the price of one unit is decided']
  quality_class varchar(1) [note: 'Code of the quality class. The class lives on the catalog item. Empty until someone picks it, as for items imported from Business Central']
  is_active boolean [not null, default: true, note: 'False once the item is removed from the price grid. The row is kept for history']
  created_at timestamptz [not null, default: `now()`, note: 'Stored in UTC']
  updated_at timestamptz [null, note: 'Stored in UTC, empty if never changed']

  indexes {
    id [pk, name: 'pk_catalog_items']
    business_central_code [unique, name: 'ix_catalog_items_business_central_code']
    quality_class [name: 'ix_catalog_items_quality_class']
  }

  checks {
    `length(name) > 0` [name: 'ck_catalog_items_name_not_empty']
    `length(category) > 0` [name: 'ck_catalog_items_category_not_empty']
    `length(business_central_code) > 0` [name: 'ck_catalog_items_business_central_code_not_empty']
    `length(unit) > 0` [name: 'ck_catalog_items_unit_not_empty']
  }

  Note: 'Types of food recognized by the app, with the Business Central code and the quality class'
}

Table prices {
  id uuid [not null, default: `gen_random_uuid()`]
  catalog_item_id uuid [not null]
  unit_price numeric(12,4) [not null, note: 'Price of one unit, in dollars']
  effective_date date [not null, note: 'First day the price applies']
  created_at timestamptz [not null, default: `now()`, note: 'Stored in UTC']

  indexes {
    id [pk, name: 'pk_prices']
    (catalog_item_id, effective_date) [unique, name: 'ix_prices_catalog_item_id_effective_date', note: 'Only one price per item and effective date']
  }

  checks {
    `unit_price > 0` [name: 'ck_prices_unit_price_positive']
  }

  Note: 'Price history: a new price is added as a new row, earlier prices are kept'
}

Table bc_item_mappings {
  id uuid [not null, default: `gen_random_uuid()`]
  business_central_code varchar(50) [not null, note: 'Item code found in the Business Central donation export']
  catalog_item_id uuid [not null, note: 'Catalog item used to value this Business Central item']
  confirmed_by_user_id integer [not null, note: 'User who last confirmed the mapping']
  confirmed_at timestamptz [not null, note: 'Stored in UTC']

  indexes {
    id [pk, name: 'pk_bc_item_mappings']
    business_central_code [unique, name: 'ix_bc_item_mappings_business_central_code', note: 'A code can only have one mapping']
    catalog_item_id [name: 'ix_bc_item_mappings_catalog_item_id']
    confirmed_by_user_id [name: 'ix_bc_item_mappings_confirmed_by_user_id']
  }

  checks {
    `length(business_central_code) > 0` [name: 'ck_bc_item_mappings_business_central_code_not_empty']
  }

  Note: 'Confirmed matches between Business Central item codes and catalog items, reused on every import. A mapping to an inactive catalog item must be reviewed'
}

Table bc_item_mapping_changes {
  id uuid [not null, default: `gen_random_uuid()`]
  business_central_code varchar(50) [not null, note: 'Copied, not linked, so the history stays after a mapping is deleted']
  action varchar(20) [not null, note: 'Created, Updated or Deleted']
  old_catalog_item_id uuid [null, note: 'Empty when the mapping was created']
  new_catalog_item_id uuid [null, note: 'Empty when the mapping was deleted']
  changed_by_user_id integer [not null]
  changed_at timestamptz [not null, default: `now()`, note: 'Stored in UTC']

  indexes {
    id [pk, name: 'pk_bc_item_mapping_changes']
    business_central_code [name: 'ix_bc_item_mapping_changes_business_central_code']
    old_catalog_item_id [name: 'ix_bc_item_mapping_changes_old_catalog_item_id']
    new_catalog_item_id [name: 'ix_bc_item_mapping_changes_new_catalog_item_id']
    changed_by_user_id [name: 'ix_bc_item_mapping_changes_changed_by_user_id']
  }

  Note: 'History of every change made to a mapping, with its author'
}

Ref fk_users_roles_role_id: users.role_id > roles.id [delete: restrict]

Ref fk_food_items_donors_donor_id: food_items.donor_id > donors.id [delete: restrict]

Ref fk_food_items_catalog_items_catalog_item_id: food_items.catalog_item_id > catalog_items.id [delete: restrict]

Ref fk_food_items_quality_classes_quality: food_items.quality > quality_classes.code [delete: restrict]

Ref fk_receipts_donors_donor_id: receipts.donor_id > donors.id [delete: restrict]

Ref fk_receipt_items_receipts_receipt_id_donor_id: receipt_items.(receipt_id, donor_id) > receipts.(id, donor_id) [delete: cascade]

Ref fk_receipt_items_food_items_food_item_id_donor_id: receipt_items.(food_item_id, donor_id) > food_items.(id, donor_id) [delete: restrict]

Ref fk_receipt_status_changes_receipts_receipt_id: receipt_status_changes.receipt_id > receipts.id [delete: restrict]

Ref fk_receipt_status_changes_users_changed_by_user_id: receipt_status_changes.changed_by_user_id > users.id [delete: restrict]

Ref fk_prices_catalog_items_catalog_item_id: prices.catalog_item_id > catalog_items.id [delete: restrict]

Ref fk_catalog_items_quality_classes_quality_class: catalog_items.quality_class > quality_classes.code [delete: restrict]

Ref fk_bc_item_mappings_catalog_items_catalog_item_id: bc_item_mappings.catalog_item_id > catalog_items.id [delete: restrict]

Ref fk_bc_item_mappings_users_confirmed_by_user_id: bc_item_mappings.confirmed_by_user_id > users.id [delete: restrict]

Ref fk_bc_item_mapping_changes_catalog_items_old_catalog_item_id: bc_item_mapping_changes.old_catalog_item_id > catalog_items.id [delete: restrict]

Ref fk_bc_item_mapping_changes_catalog_items_new_catalog_item_id: bc_item_mapping_changes.new_catalog_item_id > catalog_items.id [delete: restrict]

Ref fk_bc_item_mapping_changes_users_changed_by_user_id: bc_item_mapping_changes.changed_by_user_id > users.id [delete: restrict]

TableGroup accounts {
  roles
  users
}

TableGroup donations {
  donors
  food_items
  quality_classes
}

TableGroup tax_receipts {
  receipts
  receipt_items
  receipt_status_changes
}

TableGroup price_grid {
  catalog_items
  prices
  bc_item_mappings
  bc_item_mapping_changes
}

Records roles(id, code, name) {
  1, 'Supply', 'Supply'
  2, 'SupplyDirector', 'Supply Director'
  3, 'Finance', 'Finance'
  4, 'Admin', 'Admin'
}

Records quality_classes(code, name, percentage, min_percentage, max_percentage) {
  'A', 'Grocery quality', 100.00, 100.00, 100.00
  'B', 'Imperfect', 50.00, 50.00, 75.00
  'C', 'Near expiry', 0.00, 0.00, 0.00
}
