// Users and roles
// Paste this file into https://dbdiagram.io to render the diagram.
// Matches the migrations 20261103000127_CreateUsersAndRoles and 20261127164801_AddUserAccountChanges.

Table roles {
  id integer [not null, note: 'Fixed values, inserted by the migration']
  code varchar(50) [not null, note: 'Stable identifier used by the permission checks']
  name varchar(100) [not null, note: 'Label shown in the app']

  indexes {
    id [pk, name: 'pk_roles']
    code [unique, name: 'ix_roles_code']
    name [unique, name: 'ix_roles_name']
  }

  Note: 'Department-based roles that determine what a user can see and do'
}

Table users {
  id integer [not null, increment]
  email varchar(256) [not null, note: 'Work email, always lowercase']
  entra_object_id uuid [null, note: 'Microsoft Entra id, filled on the first permission check']
  display_name varchar(200) [not null]
  role_id integer [not null]
  is_active boolean [not null, default: true, note: 'False once the admin removes access']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [null]

  indexes {
    id [pk, name: 'pk_users']
    email [unique, name: 'ix_users_email']
    entra_object_id [unique, name: 'ix_users_entra_object_id']
    role_id [name: 'ix_users_role_id']
  }

  checks {
    `email = lower(email)` [name: 'ck_users_email_lowercase']
  }

  Note: 'Employees allowed to use the app'
}

Table user_account_changes {
  id uuid [not null, default: `gen_random_uuid()`]
  user_id integer [not null, note: 'Account that was changed']
  action varchar(20) [not null, note: 'Created, Updated, RoleChanged, Deactivated or Reactivated']
  old_email varchar(256) [null, note: 'Empty when the action did not touch the email']
  new_email varchar(256) [null]
  old_display_name varchar(200) [null, note: 'Empty when the action did not touch the name']
  new_display_name varchar(200) [null]
  old_role_id integer [null, note: 'Empty when the action did not touch the role']
  new_role_id integer [null]
  old_is_active boolean [null, note: 'Empty when the action did not touch the access']
  new_is_active boolean [null]
  changed_by_user_id integer [not null, note: 'Administrator who made the change']
  changed_at timestamptz [not null, default: `now()`, note: 'Stored in UTC']

  indexes {
    id [pk, name: 'pk_user_account_changes']
    user_id [name: 'ix_user_account_changes_user_id']
    changed_by_user_id [name: 'ix_user_account_changes_changed_by_user_id']
    old_role_id [name: 'ix_user_account_changes_old_role_id']
    new_role_id [name: 'ix_user_account_changes_new_role_id']
  }

  Note: 'History of every change made to an account, with the before and after values. Only the values the action touched are filled'
}

Ref fk_users_roles_role_id: users.role_id > roles.id [delete: restrict]

Ref fk_user_account_changes_users_user_id: user_account_changes.user_id > users.id [delete: restrict]

Ref fk_user_account_changes_users_changed_by_user_id: user_account_changes.changed_by_user_id > users.id [delete: restrict]

Ref fk_user_account_changes_roles_old_role_id: user_account_changes.old_role_id > roles.id [delete: restrict]

Ref fk_user_account_changes_roles_new_role_id: user_account_changes.new_role_id > roles.id [delete: restrict]

Records roles(id, code, name) {
  1, 'Supply', 'Supply'
  2, 'SupplyDirector', 'Supply Director'
  3, 'Finance', 'Finance'
  4, 'Admin', 'Admin'
}
