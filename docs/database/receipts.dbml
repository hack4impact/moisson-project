// Receipts and their prices
// Paste this file into https://dbdiagram.io to render the diagram.
// Matches the migration 20261107041912_CreateReceipts.
// donors and food_items come from the migration 20261105163138_CreateDonorsAndFoodItems,
// and catalog_items from 20261110175320_CreateCatalogItemsAndPrices. They are shown here because receipts link to them.

Table donors {
  id uuid [not null, default: `gen_random_uuid()`]
  name varchar(255) [not null]
  address text [null]
  postal_code varchar(20) [null]
  contact_person varchar(255) [null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    id [pk, name: 'pk_donors']
  }

  checks {
    `length(name) > 0` [name: 'ck_donors_name_not_empty']
  }

  Note: 'Organizations or people who give food'
}

Table food_items {
  id uuid [not null, default: `gen_random_uuid()`]
  donor_id uuid [not null]
  name varchar(255) [not null]
  quantity numeric(12,2) [not null]
  unit varchar(20) [not null]
  donation_date date [not null]
  quality varchar(1) [not null, note: 'A, B or C']
  catalog_item_id uuid [null, note: 'Catalog item of the donation, which gives its price. Empty until it is matched to the catalog']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    id [pk, name: 'pk_food_items']
    (id, donor_id) [unique, name: 'ak_food_items_id_donor_id', note: 'Added by CreateReceipts for the receipt_items link']
    donor_id [name: 'ix_food_items_donor_id']
    catalog_item_id [name: 'ix_food_items_catalog_item_id']
  }

  checks {
    `length(name) > 0` [name: 'ck_food_items_name_not_empty']
    `quality IN ('A', 'B', 'C')` [name: 'ck_food_items_quality']
    `quantity > 0` [name: 'ck_food_items_quantity_positive']
    `length(unit) > 0` [name: 'ck_food_items_unit_not_empty']
  }

  Note: 'Food donated by a donor, with its date and quality'
}

Table catalog_items {
  id uuid [not null, default: `gen_random_uuid()`]
  name varchar(255) [not null]
  created_at timestamptz [not null, default: `now()`, note: 'Stored in UTC']

  indexes {
    id [pk, name: 'pk_catalog_items']
  }

  checks {
    `length(name) > 0` [name: 'ck_catalog_items_name_not_empty']
  }

  Note: 'Types of food recognized by the app. Category, Business Central code, unit and quality come with #27'
}

Table receipts {
  id uuid [not null, default: `gen_random_uuid()`]
  donor_id uuid [not null]
  total_amount numeric(12,2) [not null, note: 'Sum of the rounded line values, in dollars']
  receipt_date date [not null, default: `(now() AT TIME ZONE 'America/Montreal')::date`, note: 'Date in Montreal time, used for the tax year']
  created_at timestamptz [not null, default: `now()`, note: 'Stored in UTC']

  indexes {
    id [pk, name: 'pk_receipts']
    (id, donor_id) [unique, name: 'ak_receipts_id_donor_id']
    donor_id [name: 'ix_receipts_donor_id']
  }

  checks {
    `total_amount >= 0` [name: 'ck_receipts_total_amount_not_negative']
  }

  Note: 'Tax receipts given to donors'
}

Table receipt_items {
  receipt_id uuid [not null]
  food_item_id uuid [not null]
  donor_id uuid [not null, note: 'Donor of both the receipt and the food item']
  quantity numeric(12,2) [not null, note: 'Copied from the food item when the receipt was made']
  unit varchar(20) [not null, note: 'Copied from the food item when the receipt was made']
  unit_price numeric(12,4) [not null, note: 'Price of one unit when the receipt was made']
  quality_percent numeric(5,2) [not null, note: 'A = 100, B = 50 to 75, C = 0']

  indexes {
    (receipt_id, food_item_id) [pk, name: 'pk_receipt_items']
    food_item_id [unique, name: 'ix_receipt_items_food_item_id']
    (food_item_id, donor_id) [name: 'ix_receipt_items_food_item_id_donor_id']
    (receipt_id, donor_id) [name: 'ix_receipt_items_receipt_id_donor_id']
  }

  checks {
    `quantity > 0` [name: 'ck_receipt_items_quantity_positive']
    `length(unit) > 0` [name: 'ck_receipt_items_unit_not_empty']
    `unit_price > 0` [name: 'ck_receipt_items_unit_price_positive']
    `quality_percent BETWEEN 0 AND 100` [name: 'ck_receipt_items_quality_percent_range']
  }

  Note: 'Food items on a receipt. Line value = round(quantity x unit_price x quality_percent / 100, 2), half away from zero'
}

Ref fk_food_items_donors_donor_id: food_items.donor_id > donors.id [delete: restrict]

Ref fk_food_items_catalog_items_catalog_item_id: food_items.catalog_item_id > catalog_items.id [delete: restrict]

Ref fk_receipts_donors_donor_id: receipts.donor_id > donors.id [delete: restrict]

Ref fk_receipt_items_receipts_receipt_id_donor_id: receipt_items.(receipt_id, donor_id) > receipts.(id, donor_id) [delete: cascade]

Ref fk_receipt_items_food_items_food_item_id_donor_id: receipt_items.(food_item_id, donor_id) > food_items.(id, donor_id) [delete: restrict]
